# .env 로 복사해서 채운다. (.env 는 .gitignore 에 있음)

# ---- LLM (kstock.llm.ClaudeFiller) — pip install -e ".[llm]"
ANTHROPIC_API_KEY=                 # platform.claude.com → API 키 (sk-ant-usr-… / 레거시 sk-ant-api03-…)
ANTHROPIC_WORKSPACE_ID=            # 키 범위가 '조직'(워크스페이스 미지정)일 때만: Console → 워크스페이스 → ID (wrkspc_…). Default 범위 키면 비워 둠
KSTOCK_LLM_MODEL=                  # 비우면 사용 가능한 최신 Sonnet 자동 선택. 고정하려면 예: claude-sonnet-5-5 (싸게: claude-haiku-5-5)
KSTOCK_LLM_THINKING=off            # off(기본): Claude 5 계열의 기본 사고(thinking) 를 끈다 (사고 토큰이 max_tokens 를 먹어 텍스트가 비는 것 방지). adaptive 면 모델 기본

# ---- OpenDART 공시 (collect/adapters/dart.py) — https://opendart.fss.or.kr
DART_API_KEY=

# ---- 한국투자증권 KIS Developers (collect/adapters/kis.py) — https://apiportal.koreainvestment.com
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT=            # 계좌번호 8자리-2자리
KIS_PAPER=true          # 모의투자 도메인 사용

# ---- 엔진 기본값 (선택; 코드의 Settings 와 동일 의미)
# KSTOCK_W_BASE=0.05
# KSTOCK_W_MAX=0.15
KSTOCK_PREFER_DOTENV=0             # 1 이면 이 파일의 키가 셸(Windows) 환경변수를 덮는다 — 예전 키가 환경변수에 남아 .env 를 가릴 때
